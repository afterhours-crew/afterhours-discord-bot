# Copy to .env and fill in locally. Never commit the real token.
DISCORD_TOKEN=
# The community server's numeric ID (enable Developer Mode, then Copy Server ID).
DISCORD_GUILD_ID=

# Optional: set the Active role ID to enable automatic grants and removals.
# Leave blank to disable the activity feature.
ACTIVE_ROLE_ID=
# Positive lookback in days (1–365).
ACTIVE_WINDOW_DAYS=14
# Minimum messages required, inclusive (1–10000). 3 means more than 2 messages.
ACTIVE_MIN_MESSAGES=3

# Optional: set the staff review channel ID to enable message moderation.
# Requires Message Content Intent in the Developer Portal. Leave blank to keep
# moderation off; the bot then requests no message intents at all.
MODERATION_STAFF_CHANNEL_ID=
# Community rule text loaded at startup; the revision changes with its content.
# MODERATION_RULES_PATH=rules/community-rules.md
# Messages waiting for review before new ones are dropped (1–100000).
# MODERATION_QUEUE_SIZE=1000

# Optional database path override. Leave unset with Docker Compose: it uses
# /data/nightshift.sqlite3 in the persistent nightshift-data volume.
# Local runs default to data/nightshift.sqlite3.
# NIGHTSHIFT_DATABASE_PATH=data/nightshift.sqlite3
